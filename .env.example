NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billscan
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
FILE_URL_TTL=2h

# OCR.space (text extraction from images / PDFs) — https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
# Engine 3 handles handwriting best; falls back to 2 then 1 on failure.
OCR_SPACE_ENGINE=3

# Groq (LLM that cleans up and structures OCR text) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — medium is the tested sweet spot; high tends to fail strict JSON output
GROQ_REASONING_EFFORT=medium
